# LLM API配置示例
# 复制此文件为 .env 并填入真实的API密钥

# DeepSeek API配置
# 获取API密钥: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# 通义千问API配置（可选）
# 获取API密钥: https://dashscope.console.aliyun.com/apiKey
QWEN_API_KEY=your-qwen-api-key-here

# 阿里云Embedding API配置（可选）
ALIYUN_API_KEY=your-aliyun-api-key-here

# 使用说明:
# 1. 复制此文件为 .env
# 2. 填入真实的API密钥
# 3. 在启动应用前加载环境变量:
#    - Windows: set DEEPSEEK_API_KEY=your-key
#    - Linux/Mac: export DEEPSEEK_API_KEY=your-key
# 4. 或者直接在 application.yml 中配置（不推荐提交到代码仓库）
