# 智谱 GLM Coding Plan（复制为 .env 后填入密钥）
# 必须使用 Coding 专属端点，勿用通用 open.bigmodel.cn/api/paas/v4
# 文档：https://docs.bigmodel.cn/cn/coding-plan/quick-start

ZHIPU_API_KEY=your-zhipu-coding-plan-api-key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
GLM_CHAT_MODEL=glm-4.7
GLM_VISION_MODEL=glm-4.6v

# 可选别名
# GLM_CODING_API_KEY=your-zhipu-coding-plan-api-key

LLM_FALLBACK_ENABLED=false
AI_OCR_PROVIDER=zhipu

# v2.2 全量 GLM；v3.0 本地模型时改为 hybrid 并配置 LMSTUDIO_*
LAWFIRM_AI_MODE=cloud-glm

# 其它（可选）
# DEEPSEEK_API_KEY=
# QWEN_API_KEY=
# ALIYUN_API_KEY=
