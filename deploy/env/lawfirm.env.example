# 复制到服务器：/etc/lawfirm/lawfirm.env
# chmod 600 && chown lawfirm:lawfirm

SPRING_PROFILES_ACTIVE=prod

# ---------- 首次建表（仅第一次部署时取消注释，建表成功后务必注释掉）----------
# SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ---------- MySQL ----------
LAWFIRM_DB_URL=jdbc:mysql://localhost:3306/lawfirm?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8
LAWFIRM_DB_USER=lawfirm
LAWFIRM_DB_PASSWORD=请替换为强密码

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ---------- 安全 ----------
JWT_SECRET=请替换为随机长字符串

# ---------- 智谱 GLM（必填，见 docs/GLM_CODING_PLAN_SETUP.md）----------
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
GLM_CHAT_MODEL=glm-4.7
GLM_VISION_MODEL=glm-4.6v
LAWFIRM_AI_MODE=cloud-glm
AI_OCR_PROVIDER=zhipu
LLM_FALLBACK_ENABLED=false

# ---------- 文件与备份 ----------
LAWFIRM_UPLOAD_PATH=/var/lawfirm/uploads/
BACKUP_DIR=/var/lawfirm/backups

# ---------- Qdrant（可选；无 Docker 时设为 false）----------
QDRANT_ENABLED=true
QDRANT_HOST=localhost
QDRANT_PORT=6333
CASE_SEARCH_SEMANTIC_ENABLED=true

# ---------- MinIO（若未部署 MinIO，保持默认；主要上传走本地目录）----------
# MINIO_ENDPOINT=http://127.0.0.1:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
